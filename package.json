{
  "name": "nokta",
  "type": "module",
  "engines": {
    "node": "^24.0.0"
  },
  "allowScripts": {
    "core-js@3.50.0": true,
    "esbuild@0.28.2": true,
    "fsevents": false
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && npm run generate:sitemap && npm run generate:agent-files && npm run generate:home-seed && npm run build:mcp && vite build",
    "build:mcp": "vite build --config vite.mcp.config.ts",
    "preview": "vite preview",
    "generate:sitemap": "tsx scripts/generate-sitemap.ts",
    "generate:agent-files": "tsx scripts/generate-agent-files.ts",
    "generate:home-seed": "tsx scripts/generate-home-seed.ts",
    "discover:venues": "tsx scripts/discover-venues.ts",
    "discover:venues:london": "tsx scripts/discover-venues.ts --city=london",
    "discover:venues:tranche1": "tsx scripts/discover-venues.ts --tranche=1",
    "seed:demo-venues": "tsx scripts/seed-venues.ts",
    "seed:venues": "tsx scripts/seed-real-venues.ts",
    "seed:venues:london": "tsx scripts/seed-real-venues.ts data/venues/london.generated.json",
    "seed:venues:birmingham": "tsx scripts/seed-real-venues.ts data/birmingham-venues.seed.json",
    "seed:venues:manchester": "tsx scripts/seed-real-venues.ts data/manchester-venues.seed.json",
    "seed:venues:leicester": "tsx scripts/seed-real-venues.ts data/leicester-venues.seed.json",
    "seed:venues:milton-keynes": "tsx scripts/seed-real-venues.ts data/milton-keynes-venues.seed.json",
    "check:metadata": "tsx scripts/check-metadata-parity.ts",
    "check:crawler-body": "tsx scripts/check-crawler-body.ts",
    "check:seo": "npm run check:metadata && npm run check:crawler-body",
    "reconcile:venues": "tsx scripts/reconcile-venues.ts",
    "refresh:food-hygiene": "tsx scripts/refresh-food-hygiene.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@supabase/supabase-js": "^2.112.3",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "@types/leaflet": "^1.9.22",
    "@vercel/analytics": "^2.0.1",
    "@vercel/edge": "^1.3.3",
    "@vercel/speed-insights": "^2.0.0",
    "@vitejs/plugin-react": "6.1.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "1.33.0",
    "maplibre-gl": "^5.24.0",
    "posthog-js": "^1.421.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-helmet-async": "^3.0.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "7.18.2",
    "stripe": "^22.6.0",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "vite": "8.2.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "dotenv": "^17.4.2",
    "sharp": "^0.35.4",
    "tsx": "^4.23.12",
    "typescript": "7.0.2",
    "vitest": "^5.0.5"
  }
}
