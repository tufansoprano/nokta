{
  "mailer_subjects_confirmation": "Confirm your nokta account",
  "mailer_templates_confirmation_content": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"color-scheme\" content=\"light only\">\n<meta name=\"supported-color-schemes\" content=\"light\">\n<title>Confirm your nokta account</title>\n<link href=\"https://fonts.googleapis.com/css2?family=Onest:wght@700&family=Outfit:wght@400;600;700&display=swap\" rel=\"stylesheet\">\n</head>\n<body style=\"margin:0;padding:0;background:#ffe7d2;font-family:Outfit, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;color:#1e130f;-webkit-text-size-adjust:100%\">\n<div style=\"display:none;max-height:0;overflow:hidden;opacity:0;color:transparent\">Tap the button to confirm {{ .Email }} and finish setting up your nokta account.</div>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#ffe7d2\">\n<tr><td align=\"center\" style=\"padding:32px 16px 40px\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:560px\">\n<tr><td style=\"padding:0 4px 18px\"><span style=\"font-family:Onest, Outfit, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;font-size:22px;font-weight:700;letter-spacing:0.02em;color:#1e130f\">nokta</span><span style=\"display:inline-block;width:6px;height:6px;margin-left:2px;border-radius:50%;background:#b3543c\"></span></td></tr>\n<tr><td style=\"background:#ffffff;border:1px solid #e2d0c4;border-radius:16px;padding:28px 26px\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\">\n<tr><td><span style=\"display:inline-block;padding:4px 10px;border:1px solid #e2d0c4;border-radius:999px;background:#f6eee8;font-size:12px;line-height:1.3;font-weight:600;color:#483a34\">One step left</span></td></tr>\n<tr><td style=\"padding:14px 0 0\"><h1 style=\"margin:0;font-family:Outfit, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;font-size:24px;line-height:1.25;font-weight:700;letter-spacing:-0.5px;color:#1e130f\">Confirm your email</h1></td></tr>\n<tr><td style=\"padding:8px 0 0\"><p style=\"margin:0;font-size:15px;line-height:1.6;color:#62554f\">Tap the button to confirm {{ .Email }} and finish setting up your nokta account.</p></td></tr>\n\n\n<tr><td style=\"padding:26px 0 0\"><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\"><tr><td style=\"border-radius:8px;background:#c45d3e\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;padding:13px 22px;font-family:Outfit, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;font-size:15px;font-weight:600;line-height:1.2;color:#ffffff;text-decoration:none;border-radius:8px\">Confirm email</a></td></tr></table><p style=\"margin:12px 0 0;font-size:12px;line-height:1.5;color:#62554f;word-break:break-all\">Or open <a href=\"{{ .ConfirmationURL }}\" style=\"color:#b3543c\">{{ .ConfirmationURL }}</a></p></td></tr>\n</table>\n</td></tr>\n<tr><td style=\"padding:18px 6px 0\"><p style=\"margin:0;font-size:12px;line-height:1.6;color:#62554f\">If you didn&#039;t sign up for nokta, you can ignore this email.</p></td></tr>\n</table>\n</td></tr>\n</table>\n</body>\n</html>",
  "mailer_subjects_recovery": "Reset your nokta password",
  "mailer_templates_recovery_content": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"color-scheme\" content=\"light only\">\n<meta name=\"supported-color-schemes\" content=\"light\">\n<title>Reset your nokta password</title>\n<link href=\"https://fonts.googleapis.com/css2?family=Onest:wght@700&family=Outfit:wght@400;600;700&display=swap\" rel=\"stylesheet\">\n</head>\n<body style=\"margin:0;padding:0;background:#ffe7d2;font-family:Outfit, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;color:#1e130f;-webkit-text-size-adjust:100%\">\n<div style=\"display:none;max-height:0;overflow:hidden;opacity:0;color:transparent\">Tap the button to choose a new password for {{ .Email }}. The link works once, for one hour.</div>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#ffe7d2\">\n<tr><td align=\"center\" style=\"padding:32px 16px 40px\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:560px\">\n<tr><td style=\"padding:0 4px 18px\"><span style=\"font-family:Onest, Outfit, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;font-size:22px;font-weight:700;letter-spacing:0.02em;color:#1e130f\">nokta</span><span style=\"display:inline-block;width:6px;height:6px;margin-left:2px;border-radius:50%;background:#b3543c\"></span></td></tr>\n<tr><td style=\"background:#ffffff;border:1px solid #e2d0c4;border-radius:16px;padding:28px 26px\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\">\n<tr><td><span style=\"display:inline-block;padding:4px 10px;border:1px solid #e2d0c4;border-radius:999px;background:#f6eee8;font-size:12px;line-height:1.3;font-weight:600;color:#483a34\">Password reset</span></td></tr>\n<tr><td style=\"padding:14px 0 0\"><h1 style=\"margin:0;font-family:Outfit, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;font-size:24px;line-height:1.25;font-weight:700;letter-spacing:-0.5px;color:#1e130f\">Reset your password</h1></td></tr>\n<tr><td style=\"padding:8px 0 0\"><p style=\"margin:0;font-size:15px;line-height:1.6;color:#62554f\">Tap the button to choose a new password for {{ .Email }}. The link works once, for one hour.</p></td></tr>\n\n\n<tr><td style=\"padding:26px 0 0\"><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\"><tr><td style=\"border-radius:8px;background:#c45d3e\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;padding:13px 22px;font-family:Outfit, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;font-size:15px;font-weight:600;line-height:1.2;color:#ffffff;text-decoration:none;border-radius:8px\">Choose a new password</a></td></tr></table><p style=\"margin:12px 0 0;font-size:12px;line-height:1.5;color:#62554f;word-break:break-all\">Or open <a href=\"{{ .ConfirmationURL }}\" style=\"color:#b3543c\">{{ .ConfirmationURL }}</a></p></td></tr>\n</table>\n</td></tr>\n<tr><td style=\"padding:18px 6px 0\"><p style=\"margin:0;font-size:12px;line-height:1.6;color:#62554f\">If you didn&#039;t ask to reset your password, ignore this email. Your password won&#039;t change.</p></td></tr>\n</table>\n</td></tr>\n</table>\n</body>\n</html>",
  "mailer_subjects_magic_link": "Your nokta sign-in link",
  "mailer_templates_magic_link_content": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"color-scheme\" content=\"light only\">\n<meta name=\"supported-color-schemes\" content=\"light\">\n<title>Your nokta sign-in link</title>\n<link href=\"https://fonts.googleapis.com/css2?family=Onest:wght@700&family=Outfit:wght@400;600;700&display=swap\" rel=\"stylesheet\">\n</head>\n<body style=\"margin:0;padding:0;background:#ffe7d2;font-family:Outfit, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;color:#1e130f;-webkit-text-size-adjust:100%\">\n<div style=\"display:none;max-height:0;overflow:hidden;opacity:0;color:transparent\">Tap the button to sign in as {{ .Email }}. The link works once, for one hour.</div>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#ffe7d2\">\n<tr><td align=\"center\" style=\"padding:32px 16px 40px\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:560px\">\n<tr><td style=\"padding:0 4px 18px\"><span style=\"font-family:Onest, Outfit, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;font-size:22px;font-weight:700;letter-spacing:0.02em;color:#1e130f\">nokta</span><span style=\"display:inline-block;width:6px;height:6px;margin-left:2px;border-radius:50%;background:#b3543c\"></span></td></tr>\n<tr><td style=\"background:#ffffff;border:1px solid #e2d0c4;border-radius:16px;padding:28px 26px\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\">\n<tr><td><span style=\"display:inline-block;padding:4px 10px;border:1px solid #e2d0c4;border-radius:999px;background:#f6eee8;font-size:12px;line-height:1.3;font-weight:600;color:#483a34\">Sign in</span></td></tr>\n<tr><td style=\"padding:14px 0 0\"><h1 style=\"margin:0;font-family:Outfit, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;font-size:24px;line-height:1.25;font-weight:700;letter-spacing:-0.5px;color:#1e130f\">Sign in to nokta</h1></td></tr>\n<tr><td style=\"padding:8px 0 0\"><p style=\"margin:0;font-size:15px;line-height:1.6;color:#62554f\">Tap the button to sign in as {{ .Email }}. The link works once, for one hour.</p></td></tr>\n\n\n<tr><td style=\"padding:26px 0 0\"><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\"><tr><td style=\"border-radius:8px;background:#c45d3e\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;padding:13px 22px;font-family:Outfit, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;font-size:15px;font-weight:600;line-height:1.2;color:#ffffff;text-decoration:none;border-radius:8px\">Sign in</a></td></tr></table><p style=\"margin:12px 0 0;font-size:12px;line-height:1.5;color:#62554f;word-break:break-all\">Or open <a href=\"{{ .ConfirmationURL }}\" style=\"color:#b3543c\">{{ .ConfirmationURL }}</a></p></td></tr>\n</table>\n</td></tr>\n<tr><td style=\"padding:18px 6px 0\"><p style=\"margin:0;font-size:12px;line-height:1.6;color:#62554f\">If you didn&#039;t ask for this, you can ignore this email.</p></td></tr>\n</table>\n</td></tr>\n</table>\n</body>\n</html>",
  "mailer_subjects_email_change": "Confirm your new email for nokta",
  "mailer_templates_email_change_content": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"color-scheme\" content=\"light only\">\n<meta name=\"supported-color-schemes\" content=\"light\">\n<title>Confirm your new email for nokta</title>\n<link href=\"https://fonts.googleapis.com/css2?family=Onest:wght@700&family=Outfit:wght@400;600;700&display=swap\" rel=\"stylesheet\">\n</head>\n<body style=\"margin:0;padding:0;background:#ffe7d2;font-family:Outfit, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;color:#1e130f;-webkit-text-size-adjust:100%\">\n<div style=\"display:none;max-height:0;overflow:hidden;opacity:0;color:transparent\">Confirm you want your nokta account to use {{ .NewEmail }} instead of {{ .Email }}.</div>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#ffe7d2\">\n<tr><td align=\"center\" style=\"padding:32px 16px 40px\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:560px\">\n<tr><td style=\"padding:0 4px 18px\"><span style=\"font-family:Onest, Outfit, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;font-size:22px;font-weight:700;letter-spacing:0.02em;color:#1e130f\">nokta</span><span style=\"display:inline-block;width:6px;height:6px;margin-left:2px;border-radius:50%;background:#b3543c\"></span></td></tr>\n<tr><td style=\"background:#ffffff;border:1px solid #e2d0c4;border-radius:16px;padding:28px 26px\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\">\n<tr><td><span style=\"display:inline-block;padding:4px 10px;border:1px solid #e2d0c4;border-radius:999px;background:#f6eee8;font-size:12px;line-height:1.3;font-weight:600;color:#483a34\">Email change</span></td></tr>\n<tr><td style=\"padding:14px 0 0\"><h1 style=\"margin:0;font-family:Outfit, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;font-size:24px;line-height:1.25;font-weight:700;letter-spacing:-0.5px;color:#1e130f\">Confirm your new email</h1></td></tr>\n<tr><td style=\"padding:8px 0 0\"><p style=\"margin:0;font-size:15px;line-height:1.6;color:#62554f\">Confirm you want your nokta account to use {{ .NewEmail }} instead of {{ .Email }}.</p></td></tr>\n\n\n<tr><td style=\"padding:26px 0 0\"><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\"><tr><td style=\"border-radius:8px;background:#c45d3e\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;padding:13px 22px;font-family:Outfit, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;font-size:15px;font-weight:600;line-height:1.2;color:#ffffff;text-decoration:none;border-radius:8px\">Confirm new email</a></td></tr></table><p style=\"margin:12px 0 0;font-size:12px;line-height:1.5;color:#62554f;word-break:break-all\">Or open <a href=\"{{ .ConfirmationURL }}\" style=\"color:#b3543c\">{{ .ConfirmationURL }}</a></p></td></tr>\n</table>\n</td></tr>\n<tr><td style=\"padding:18px 6px 0\"><p style=\"margin:0;font-size:12px;line-height:1.6;color:#62554f\">If you didn&#039;t ask for this, you can ignore this email.</p></td></tr>\n</table>\n</td></tr>\n</table>\n</body>\n</html>",
  "mailer_subjects_invite": "You're invited to nokta",
  "mailer_templates_invite_content": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"color-scheme\" content=\"light only\">\n<meta name=\"supported-color-schemes\" content=\"light\">\n<title>You&#039;re invited to nokta</title>\n<link href=\"https://fonts.googleapis.com/css2?family=Onest:wght@700&family=Outfit:wght@400;600;700&display=swap\" rel=\"stylesheet\">\n</head>\n<body style=\"margin:0;padding:0;background:#ffe7d2;font-family:Outfit, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;color:#1e130f;-webkit-text-size-adjust:100%\">\n<div style=\"display:none;max-height:0;overflow:hidden;opacity:0;color:transparent\">Tap the button to accept and set up your account for {{ .Email }}.</div>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#ffe7d2\">\n<tr><td align=\"center\" style=\"padding:32px 16px 40px\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:560px\">\n<tr><td style=\"padding:0 4px 18px\"><span style=\"font-family:Onest, Outfit, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;font-size:22px;font-weight:700;letter-spacing:0.02em;color:#1e130f\">nokta</span><span style=\"display:inline-block;width:6px;height:6px;margin-left:2px;border-radius:50%;background:#b3543c\"></span></td></tr>\n<tr><td style=\"background:#ffffff;border:1px solid #e2d0c4;border-radius:16px;padding:28px 26px\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\">\n<tr><td><span style=\"display:inline-block;padding:4px 10px;border:1px solid #b6d1ee;border-radius:999px;background:#ddedff;font-size:12px;line-height:1.3;font-weight:600;color:#1d456b\">Invitation</span></td></tr>\n<tr><td style=\"padding:14px 0 0\"><h1 style=\"margin:0;font-family:Outfit, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;font-size:24px;line-height:1.25;font-weight:700;letter-spacing:-0.5px;color:#1e130f\">You&#039;re invited to nokta</h1></td></tr>\n<tr><td style=\"padding:8px 0 0\"><p style=\"margin:0;font-size:15px;line-height:1.6;color:#62554f\">Tap the button to accept and set up your account for {{ .Email }}.</p></td></tr>\n\n\n<tr><td style=\"padding:26px 0 0\"><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\"><tr><td style=\"border-radius:8px;background:#c45d3e\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;padding:13px 22px;font-family:Outfit, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;font-size:15px;font-weight:600;line-height:1.2;color:#ffffff;text-decoration:none;border-radius:8px\">Accept invitation</a></td></tr></table><p style=\"margin:12px 0 0;font-size:12px;line-height:1.5;color:#62554f;word-break:break-all\">Or open <a href=\"{{ .ConfirmationURL }}\" style=\"color:#b3543c\">{{ .ConfirmationURL }}</a></p></td></tr>\n</table>\n</td></tr>\n<tr><td style=\"padding:18px 6px 0\"><p style=\"margin:0;font-size:12px;line-height:1.6;color:#62554f\">If you didn&#039;t ask for this, you can ignore this email.</p></td></tr>\n</table>\n</td></tr>\n</table>\n</body>\n</html>"
}
